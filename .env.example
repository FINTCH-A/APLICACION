# ─── App ─────────────────────────────────────────────────────
APP_NAME=AvanteCreditos
APP_VERSION=1.0.0
APP_ENV=development

# ─── API ─────────────────────────────────────────────────────

# LOCALHOST (DESARROLLO BACKEND)
# Solo referencia para desarrolladores
API_URL=http://localhost:3000/api/v1

# EMULADOR ANDROID
# API_URL=http://10.0.2.2:3000/api/v1

# CELULAR FISICO
API_URL=http://192.168.18.28:3000/api/v1

# PRODUCCION
# API_URL=https://api.avantefintech.com/api/v1

API_TIMEOUT=30000

# ─── Features ────────────────────────────────────────────────
ENABLE_BIOMETRICS=false
ENABLE_NOTIFICATIONS=true
ENABLE_OFFLINE_MODE=false

# ─── Storage Keys ────────────────────────────────────────────
TOKEN_KEY=auth_token
REFRESH_TOKEN_KEY=refresh_token
USER_DATA_KEY=user_data
THEME_KEY=theme_mode
